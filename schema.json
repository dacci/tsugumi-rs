{
  "$ref": "#/definitions/Book",
  "definitions": {
    "Book": {
      "type": "object",
      "required": [
        "metadata",
        "chapter"
      ],
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/definitions/Metadata"
        },
        "rendition": {
          "$ref": "#/definitions/Rendition"
        },
        "chapter": {
          "oneOf": [
            {
              "$ref": "#/definitions/Chapter"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/Chapter"
              }
            }
          ]
        }
      }
    },
    "Metadata": {
      "type": "object",
      "required": [
        "title",
        "language",
        "identifier"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "oneOf": [
            {
              "$ref": "#/definitions/TitleText"
            },
            {
              "$ref": "#/definitions/Title"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/TitleText"
                  },
                  {
                    "$ref": "#/definitions/Title"
                  }
                ]
              }
            }
          ]
        },
        "creator": {
          "oneOf": [
            {
              "$ref": "#/definitions/CreatorText"
            },
            {
              "$ref": "#/definitions/Creator"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/CreatorText"
                  },
                  {
                    "$ref": "#/definitions/Creator"
                  }
                ]
              }
            }
          ]
        },
        "contributor": {
          "oneOf": [
            {
              "$ref": "#/definitions/CreatorText"
            },
            {
              "$ref": "#/definitions/Creator"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/definitions/CreatorText"
                  },
                  {
                    "$ref": "#/definitions/Creator"
                  }
                ]
              }
            }
          ]
        },
        "collection": {
          "oneOf": [
            {
              "$ref": "#/definitions/Collection"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Collection"
              }
            }
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TitleText": {
      "type": "string",
      "minLength": 1
    },
    "Title": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/TitleType"
        },
        "text": {
          "$ref": "#/definitions/TitleText"
        },
        "fileAs": {
          "type": "string"
        },
        "alternateScript": {
          "type": "string"
        }
      }
    },
    "TitleType": {
      "type": "string",
      "enum": [
        "main",
        "subtitle",
        "short",
        "collection",
        "edition",
        "expanded"
      ],
      "default": "main"
    },
    "CreatorText": {
      "type": "string",
      "minLength": 1
    },
    "Creator": {
      "type": "object",
      "required": [
        "role",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "text": {
          "$ref": "#/definitions/CreatorText"
        },
        "fileAs": {
          "type": "string"
        },
        "alternateScript": {
          "type": "string"
        }
      }
    },
    "Collection": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/CollectionType"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "integer"
        }
      }
    },
    "CollectionType": {
      "type": "string",
      "enum": [
        "series",
        "set"
      ]
    },
    "Rendition": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/definitions/Direction"
        },
        "layout": {
          "$ref": "#/definitions/Layout"
        },
        "orientation": {
          "$ref": "#/definitions/Orientation"
        },
        "spread": {
          "$ref": "#/definitions/Spread"
        },
        "style": {
          "oneOf": [
            {
              "$ref": "#/definitions/Style"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Style"
              }
            }
          ]
        }
      }
    },
    "Direction": {
      "type": "string",
      "enum": [
        "rtl",
        "ltr"
      ],
      "default": "rtl"
    },
    "Layout": {
      "type": "string",
      "enum": [
        "reflowable",
        "pre-paginated"
      ],
      "default": "pre-paginated"
    },
    "Orientation": {
      "type": "string",
      "enum": [
        "landscape",
        "portrait",
        "auto"
      ],
      "default": "auto"
    },
    "Spread": {
      "type": "string",
      "enum": [
        "none",
        "landscape",
        "both",
        "auto"
      ],
      "default": "auto"
    },
    "Style": {
      "type": "object",
      "required": [
        "href",
        "src"
      ],
      "additionalProperties": false,
      "properties": {
        "link": {
          "type": "boolean"
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Chapter": {
      "type": "object",
      "required": [
        "page"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "page": {
          "oneOf": [
            {
              "$ref": "#/definitions/Page"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/Page"
              }
            }
          ]
        },
        "cover": {
          "type": "boolean"
        }
      }
    },
    "Page": {
      "type": "string",
      "minLength": 1
    }
  }
}
